{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Adversarial Review Output",
  "description": "Structured output from Codex adversarial code review",
  "type": "object",
  "required": ["verdict", "summary", "findings", "next_steps"],
  "properties": {
    "verdict": {
      "type": "string",
      "enum": ["approve", "needs-attention", "insufficient-context"],
      "description": "Overall verdict. 'approve' only if zero critical/high findings. 'insufficient-context' when diff is too small, truncated, or lacks enough surrounding code for a meaningful review."
    },
    "summary": {
      "type": "string",
      "description": "One paragraph overall assessment of the changes."
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["severity", "title", "file", "line_range", "confidence", "description", "recommendation"],
        "properties": {
          "severity": {
            "type": "string",
            "enum": ["critical", "high", "medium", "low"],
            "description": "Issue severity level."
          },
          "title": {
            "type": "string",
            "description": "One-line summary of the issue."
          },
          "file": {
            "type": "string",
            "description": "File path affected by the issue."
          },
          "line_range": {
            "type": "string",
            "description": "Approximate line range, e.g. '42-58'."
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "Confidence score from 0.0 to 1.0."
          },
          "description": {
            "type": "string",
            "description": "Detailed explanation of the issue and why it matters."
          },
          "recommendation": {
            "type": "string",
            "description": "Concrete fix or investigation step."
          }
        },
        "additionalProperties": false
      },
      "description": "List of findings ordered by severity."
    },
    "next_steps": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Actionable next steps for the developer."
    }
  },
  "additionalProperties": false
}
